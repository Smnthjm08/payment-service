  "query": "\n            UPDATE payment_attempts\n            SET\n                status       = $2,\n                psp_ref      = $3,\n                psp_response = $4,\n                failure_code = $5,\n                updated_at   = NOW()\n            WHERE id = $1\n            RETURNING\n                id,\n                invoice_id,\n                status AS \"status: _\",\n                amount_cents,\n                card_token,\n                psp_ref,\n                psp_response,\n                failure_code,\n                created_at,\n                updated_at\n            ",

  "query": "\n            UPDATE invoices\n            SET\n                state      = 'Open',\n                updated_at = NOW()\n            WHERE id    = $1\n              AND state = 'Processing'\n            RETURNING\n                id,\n                business_id,\n                customer_id,\n                state,\n                total_amount_cents,\n                due_date,\n                created_at,\n                updated_at,\n                paid_at\n            ",

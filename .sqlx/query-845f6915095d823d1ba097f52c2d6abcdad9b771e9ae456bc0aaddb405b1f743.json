  "query": "\n            SELECT\n                id,\n                business_id,\n                key,\n                request_hash,\n                response_body,\n                status_code,\n                created_at,\n                expires_at\n            FROM idempotency_keys\n            WHERE business_id = $1\n              AND key = $2\n              AND expires_at > NOW()\n            LIMIT 1\n            ",

  "query": "\n            SELECT\n                id,\n                business_id,\n                key_prefix,\n                key_hash,\n                is_active,\n                created_at,\n                revoked_at\n            FROM api_keys\n            WHERE key_prefix = $1 AND is_active = true AND revoked_at IS NULL\n            LIMIT 1\n            ",
